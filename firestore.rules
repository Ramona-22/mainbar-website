rules_version = '2';

// Firestore security rules for the MainBar website.
//
// The Firebase API key is public (it ships to every browser), so these rules
// are the ONLY thing protecting customer data. Deploy them with:
//   npx firebase-tools deploy --only firestore:rules --project <project-id>
// or paste this file into Firebase console > Firestore > Rules.
//
// Admins: the signed-in account mainbarsw@gmail.com, plus any extra account
// whose UID has a document at admins/{uid} (add in the Firebase console).
// Being signed in alone is NOT enough, because anyone can create a Firebase
// account with the public API key.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = the owner account below, or any account listed in admins/{uid}.
    // Firebase allows only one account per email, and mainbarsw@gmail.com
    // already exists, so nobody else can sign up with it.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'mainbarsw@gmail.com'
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Event / catering requests: public can create, only admins can see them.
    match /bookings/{id} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow create: if
        request.resource.data.keys().hasOnly(
          ['seating', 'guests', 'date', 'state', 'city', 'phone', 'email', 'status', 'createdAt'])
        && request.resource.data.seating in ['inside', 'outside', 'catering']
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1 && request.resource.data.guests <= 30
        && shortString(request.resource.data.date, 40)
        && shortString(request.resource.data.state, 200)
        && shortString(request.resource.data.city, 200)
        && shortString(request.resource.data.phone, 40)
        && shortString(request.resource.data.email, 200)
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.status == 'Neu'
        && request.resource.data.createdAt == request.time;
    }

    // Guest reviews: anyone can submit one, but it is only public after an
    // admin approves it in /admin.
    match /reviews/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
        && request.resource.data.approved is bool;
      allow create: if
        request.resource.data.keys().hasOnly(['author', 'text', 'rating', 'approved', 'createdAt'])
        && request.resource.data.approved == false
        && shortString(request.resource.data.author, 80)
        && shortString(request.resource.data.text, 1000)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
    }

    // Menu: public read, admin write.
    match /menu/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin allow-list: managed only in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
