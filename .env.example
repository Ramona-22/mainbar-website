# Firebase client config (from Firebase console > Project settings > General)
# These are public by design (used in the browser) — access control is enforced
# by Firestore security rules, not by keeping these secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gmail account used to send booking notification emails (app/api/booking).
# GMAIL_APP_PASSWORD must be a Gmail "App Password", not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Upstash Redis (free tier at upstash.com) — REQUIRED IN PRODUCTION so
# /api/booking's rate limiting actually applies. Without these set, rate
# limiting fails open (allows all requests) so local dev isn't blocked.
# Create a database at upstash.com, then copy the REST URL/token from its
# dashboard — no other setup needed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL of the deployed site (used for sitemap.xml, robots.txt and social previews).
NEXT_PUBLIC_SITE_URL=https://www.mainbar-sw.de

# Secret for signing GDPR deletion confirmation links (/api/gdpr-delete).
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, the "Daten löschen" footer link tells visitors to email instead.
GDPR_TOKEN_SECRET=

# Firebase service account (Firebase console > Project settings > Service accounts >
# "Generate new private key"), pasted as the full JSON on one line. Server-only — used by
# the GDPR deletion flow to read/delete bookings, which Firestore rules block for visitors.
FIREBASE_SERVICE_ACCOUNT_KEY=
